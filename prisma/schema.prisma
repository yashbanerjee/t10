generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  STATISTICS_MANAGER
  CONTENT_MANAGER
}

enum PlayerRole {
  BATTER
  BOWLER
  ALL_ROUNDER
  WICKETKEEPER
}

enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum UpdateCategory {
  TRAINING
  MATCH_DAY
  TEAM_NEWS
  PLAYER_NEWS
  ANNOUNCEMENT
  BEHIND_THE_SCENES
  MEDIA
  TRAVEL
  COMMUNITY
}

enum Permission {
  TEAM_READ
  TEAM_WRITE
  MATCH_READ
  MATCH_WRITE
  STATS_READ
  STATS_WRITE
  CONTENT_READ
  CONTENT_WRITE
  MEDIA_WRITE
  SETTINGS_WRITE
  USERS_WRITE
  AUDIT_READ
  MESSAGES_READ
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         Role           @default(EDITOR)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  uploads      Media[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Team {
  id             String        @id @default(cuid())
  name           String        @unique
  shortName      String
  slug           String        @unique
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  description    String?
  players        Player[]
  staff          StaffMember[]
  seasons        Season[]
  sponsors       Sponsor[]
  records        TeamRecord[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Season {
  id          String         @id @default(cuid())
  name        String
  year        Int            @unique
  isCurrent   Boolean        @default(false)
  isDemo      Boolean        @default(false)
  teamId      String
  team        Team           @relation(fields: [teamId], references: [id])
  tournaments Tournament[]
  players     PlayerSeason[]
  matches     Match[]
  points      PointsEntry[]
  createdAt   DateTime       @default(now())

  @@index([year])
}

model Tournament {
  id        String   @id @default(cuid())
  name      String
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  matches   Match[]
  createdAt DateTime @default(now())

  @@unique([name, seasonId])
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  city      String?
  country   String?
  matches   Match[]
  createdAt DateTime @default(now())

  @@unique([name, city])
}

model Player {
  id            String                @id @default(cuid())
  fullName      String
  shortName     String?
  displayName   String?
  slug          String                @unique
  profileImage  String?
  coverImage    String?
  jerseyNumber  Int?
  country       String?
  nationality   String?
  dateOfBirth   DateTime?
  role          PlayerRole?
  battingStyle  String?
  bowlingStyle  String?
  heightCm      Int?
  bio           String?
  isCaptain     Boolean               @default(false)
  isViceCaptain Boolean               @default(false)
  isIconPlayer  Boolean               @default(false)
  isActive      Boolean               @default(true)
  isDemo        Boolean               @default(false)
  displayOrder  Int                   @default(0)
  socialLinks   Json?
  careerRecord  Json?
  teamId        String
  team          Team                  @relation(fields: [teamId], references: [id])
  seasons       PlayerSeason[]
  batting       BattingPerformance[]
  bowling       BowlingPerformance[]
  fielding      FieldingPerformance[]
  updates       TeamUpdate[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([isActive, displayOrder])
  @@index([teamId])
}

model PlayerSeason {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([playerId, seasonId])
  @@index([playerId])
  @@index([seasonId])
}

model StaffMember {
  id           String   @id @default(cuid())
  fullName     String
  title        String
  category     String
  bio          String?
  profileImage String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId, category, displayOrder])
}

model Match {
  id              String                @id @default(cuid())
  slug            String                @unique
  matchNumber     String?
  date            DateTime
  status          MatchStatus           @default(UPCOMING)
  opponent        String
  opponentShort   String?
  opponentLogoUrl String?
  competition     String?
  venueId         String?
  venue           Venue?                @relation(fields: [venueId], references: [id], onDelete: SetNull)
  seasonId        String
  season          Season                @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tournamentId    String?
  tournament      Tournament?           @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  innings         Innings[]
  matchTeams      MatchTeam[]
  fielding        FieldingPerformance[]
  toss            String?
  result          String?
  playerOfMatchId String?
  liveState       Json?
  isDemo          Boolean               @default(false)
  updates         TeamUpdate[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([date])
  @@index([status, date])
  @@index([seasonId])
}

model MatchTeam {
  id       String   @id @default(cuid())
  matchId  String
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamName String
  isHome   Boolean  @default(false)
  score    String?
  overs    Decimal? @db.Decimal(4, 1)
  result   String?

  @@index([matchId])
}

model Innings {
  id          String               @id @default(cuid())
  matchId     String
  match       Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  number      Int
  battingTeam String
  runs        Int                  @default(0)
  wickets     Int                  @default(0)
  overs       Decimal              @default(0) @db.Decimal(4, 1)
  batting     BattingPerformance[]
  bowling     BowlingPerformance[]
  createdAt   DateTime             @default(now())

  @@unique([matchId, number])
}

model BattingPerformance {
  id        String   @id @default(cuid())
  inningsId String
  innings   Innings  @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  runs      Int      @default(0)
  balls     Int      @default(0)
  fours     Int      @default(0)
  sixes     Int      @default(0)
  dismissal String?
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([inningsId])
}

model BowlingPerformance {
  id        String   @id @default(cuid())
  inningsId String
  innings   Innings  @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  overs     Decimal  @default(0) @db.Decimal(4, 1)
  maidens   Int      @default(0)
  runs      Int      @default(0)
  wickets   Int      @default(0)
  wides     Int      @default(0)
  noBalls   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([inningsId])
}

model FieldingPerformance {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  catches   Int      @default(0)
  runOuts   Int      @default(0)
  stumpings Int      @default(0)
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([matchId])
}

model NewsArticle {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String
  content        String
  coverImage     String?
  authorName     String?
  category       String
  status         NewsStatus @default(DRAFT)
  isFeatured     Boolean    @default(false)
  isDemo         Boolean    @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
}

model TeamUpdate {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String
  content     String?
  image       String?
  video       String?
  category    UpdateCategory
  publishedAt DateTime
  isFeatured  Boolean        @default(false)
  isPublished Boolean        @default(false)
  isDemo      Boolean        @default(false)
  playerId    String?
  player      Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)
  matchId     String?
  match       Match?         @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([publishedAt, isPublished])
  @@index([category])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  startsAt  DateTime
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Media {
  id           String    @id @default(cuid())
  url          String
  type         MediaType
  altText      String?
  caption      String?
  folder       String?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([type, folder])
}

model Gallery {
  id           String    @id @default(cuid())
  title        String
  category     String
  mediaUrl     String
  type         MediaType @default(IMAGE)
  altText      String?
  displayOrder Int       @default(0)
  isPublished  Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([category, displayOrder])
}

model Video {
  id          String   @id @default(cuid())
  title       String
  url         String
  thumbnail   String?
  description String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Sponsor {
  id           String   @id @default(cuid())
  name         String
  category     String
  logoUrl      String?
  website      String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  isDemo       Boolean  @default(false)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([category, displayOrder])
}

model Franchise {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  league       String
  logoUrl      String?
  facebook     String?
  instagram    String?
  x            String?
  youtube      String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

model SocialLink {
  id           String   @id @default(cuid())
  platform     String
  handle       String
  url          String
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model TeamRecord {
  id         String   @id @default(cuid())
  title      String
  value      String
  category   String
  scope      String   @default("LIFETIME")
  playerName String?
  seasonYear Int?
  isDemo     Boolean  @default(false)
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model PointsEntry {
  id         String  @id @default(cuid())
  seasonId   String
  season     Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamName   String
  played     Int     @default(0)
  won        Int     @default(0)
  lost       Int     @default(0)
  noResult   Int     @default(0)
  points     Int     @default(0)
  netRunRate Decimal @default(0) @db.Decimal(7, 3)
  position   Int     @default(0)
  isDemo     Boolean @default(false)

  @@unique([seasonId, teamName])
  @@index([seasonId, position])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

enum ProductCategory {
  JERSEY
  TRAINING
  CAP
  ACCESSORY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  price       Decimal         @db.Decimal(10, 2)
  image       String?
  images      String[]        @default([])
  category    ProductCategory @default(JERSEY)
  isPublished Boolean         @default(true)
  isFeatured  Boolean         @default(false)
  variants    ProductVariant[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  size      String
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(10, 2)
  image     String?

  @@unique([productId, color, size])
  @@index([productId])
}

model Order {
  id        String      @id @default(cuid())
  number    String      @unique
  name      String
  email     String
  phone     String
  address   String
  city      String
  country   String
  notes     String?
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(10, 2)
  items     OrderItem[]
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   String?
  stripeSessionId String?       @unique
  paidAt          DateTime?
  createdAt DateTime    @default(now())

  @@index([email, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  productName String
  color       String
  size        String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
}

model Poll {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  question    String
  description String?
  closesAt    DateTime?
  isPublished Boolean      @default(true)
  options     PollOption[]
  votes       PollVote[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PollOption {
  id           String     @id @default(cuid())
  pollId       String
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label        String
  displayOrder Int        @default(0)
  votes        PollVote[]

  @@index([pollId, displayOrder])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String
  createdAt DateTime   @default(now())

  @@unique([pollId, email])
}

model Contest {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String
  prize       String?
  prompt      String
  image       String?
  closesAt    DateTime?
  isPublished Boolean        @default(true)
  entries     ContestEntry[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ContestEntry {
  id        String   @id @default(cuid())
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String
  answer    String
  createdAt DateTime @default(now())

  @@unique([contestId, email])
  @@index([contestId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}
